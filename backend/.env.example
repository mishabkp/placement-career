# PlacementPal AI Backend Environment Variables
PROJECT_NAME="PlacementPal AI Backend"
VERSION="1.0.0"

# Secret key for JWT auth (generate using: openssl rand -hex 32)
SECRET_KEY="your_super_secret_jwt_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# Gemini AI API Key (from https://aistudio.google.com)
GEMINI_API_KEY="your_gemini_api_key_here"

# Database URL:
# For Local Development (SQLite):
DATABASE_URL="sqlite:///./placementpal.db"
# For Render / Production (Neon or Supabase PostgreSQL):
# DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require"

# Optional: GitHub personal access token for higher rate limits on GitHub analyzer
# GITHUB_TOKEN=""
